# Docker Compose local development configuration. Copy to .env to customize.
POSTGRES_PORT=5432
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_local_password

REDIS_PORT=6379

TYPESENSE_PORT=8108
TYPESENSE_API_KEY=atlas-local-typesense-key-change-me

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=atlasminio
MINIO_ROOT_PASSWORD=atlasminio_local_password

MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Maximum time, in seconds, that scripts/dev-up.sh waits for healthy services.
COMPOSE_WAIT_TIMEOUT=120
