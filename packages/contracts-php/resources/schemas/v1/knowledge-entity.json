{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/contracts/schemas/v1/knowledge-entity.json",
  "title": "KnowledgeEntity v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "entity_id",
    "entity_type",
    "stable_key",
    "lifecycle_state",
    "provenance",
    "command"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "entity_id": { "type": "string", "format": "uuid" },
    "entity_type": { "type": "string", "minLength": 1 },
    "stable_key": { "type": "string", "minLength": 1 },
    "lifecycle_state": { "$ref": "#/$defs/lifecycleState" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "command": { "$ref": "#/$defs/command" }
  },
  "$defs": {
    "lifecycleState": {
      "enum": ["observed", "draft", "candidate", "review", "published", "superseded", "retracted"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_observation_id",
        "source_revision",
        "method",
        "confidence",
        "processed_at"
      ],
      "properties": {
        "source_observation_id": { "type": "string", "format": "uuid" },
        "source_revision": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "processed_at": { "type": "string", "format": "date-time" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": true,
      "required": ["idempotency_key", "actor"],
      "properties": {
        "idempotency_key": { "type": "string", "minLength": 1 },
        "actor": {
          "type": "object",
          "additionalProperties": true,
          "required": ["actor_id", "actor_type"],
          "properties": {
            "actor_id": { "type": "string", "minLength": 1 },
            "actor_type": { "enum": ["human", "service", "plugin", "worker"] }
          }
        }
      }
    }
  }
}
