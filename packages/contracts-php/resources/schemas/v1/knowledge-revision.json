{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/contracts/schemas/v1/knowledge-revision.json",
  "title": "KnowledgeRevision v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "revision_id",
    "entity_id",
    "source_observation_id",
    "source_revision",
    "lifecycle_state",
    "method",
    "confidence",
    "processed_at",
    "checksum",
    "command"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "revision_id": { "type": "string", "format": "uuid" },
    "entity_id": { "type": "string", "format": "uuid" },
    "source_observation_id": { "type": "string", "format": "uuid" },
    "source_revision": { "type": "string", "minLength": 1 },
    "lifecycle_state": { "$ref": "#/$defs/lifecycleState" },
    "method": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "processed_at": { "type": "string", "format": "date-time" },
    "checksum": { "type": "string", "minLength": 1 },
    "content_ref": { "type": "object", "additionalProperties": true },
    "command": { "$ref": "#/$defs/command" }
  },
  "$defs": {
    "lifecycleState": {
      "enum": ["observed", "draft", "candidate", "review", "published", "superseded", "retracted"]
    },
    "command": {
      "type": "object",
      "additionalProperties": true,
      "required": ["idempotency_key", "actor"],
      "properties": {
        "idempotency_key": { "type": "string", "minLength": 1 },
        "actor": {
          "type": "object",
          "additionalProperties": true,
          "required": ["actor_id", "actor_type"],
          "properties": {
            "actor_id": { "type": "string", "minLength": 1 },
            "actor_type": { "enum": ["human", "service", "plugin", "worker"] }
          }
        }
      }
    }
  }
}
