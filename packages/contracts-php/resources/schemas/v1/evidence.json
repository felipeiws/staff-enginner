{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/contracts/schemas/v1/evidence.json",
  "title": "Evidence v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "evidence_id",
    "kind",
    "pointer",
    "checksum",
    "provenance",
    "command"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "evidence_id": { "type": "string", "format": "uuid" },
    "kind": { "enum": ["chunk", "artifact", "event"] },
    "pointer": { "type": "string", "minLength": 1 },
    "offsets": { "$ref": "#/$defs/offsets" },
    "checksum": { "type": "string", "minLength": 1 },
    "provenance": { "$ref": "#/$defs/provenance" },
    "command": { "$ref": "#/$defs/command" }
  },
  "$defs": {
    "offsets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "unit": { "enum": ["byte", "character", "line", "token"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_revision", "method", "processed_at"],
      "properties": {
        "source_revision": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "processed_at": { "type": "string", "format": "date-time" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": true,
      "required": ["idempotency_key", "actor"],
      "properties": {
        "idempotency_key": { "type": "string", "minLength": 1 },
        "actor": {
          "type": "object",
          "additionalProperties": true,
          "required": ["actor_id", "actor_type"],
          "properties": {
            "actor_id": { "type": "string", "minLength": 1 },
            "actor_type": { "enum": ["human", "service", "plugin", "worker"] }
          }
        }
      }
    }
  }
}
