{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/contracts/schemas/v1/content-parse-result.json",
  "title": "Content parsed result v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "event_type", "task_id", "revision_id", "scope", "artifact_uri", "provenance", "chunks", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "event_type": {"const": "ContentParsed"}, "task_id": {"type": "string", "format": "uuid"}, "revision_id": {"type": "string", "format": "uuid"}, "scope": {"type": "object", "additionalProperties": {"type": "string"}}, "artifact_uri": {"type": "string", "minLength": 1},
    "provenance": {"type": "object", "required": ["source_observation_id", "source_revision", "method", "processed_at"]},
    "chunks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["ordinal", "start_offset", "end_offset", "text", "tokens", "checksum", "artifact_uri"]}},
    "candidates": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["entity_type", "title", "stable_key", "lifecycle_state", "confidence", "provenance", "evidence"], "properties": {"entity_type": {"enum": ["Documento", "ADR", "FAQ", "Regra", "Aplicação", "Endpoint", "Schema", "Evento"]}, "lifecycle_state": {"const": "candidate"}}}},
    "assertions": {"type": "array", "items": {"type": "object", "required": ["subject_stable_key", "predicate", "object_stable_key", "lifecycle_state", "confidence", "method", "provenance"], "properties": {"predicate": {"enum": ["exposes", "consumes", "produces"]}, "lifecycle_state": {"const": "candidate"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "contract_divergences": {"type": "array", "items": {"type": "object", "required": ["kind", "severity", "endpoint", "message", "method"], "properties": {"severity": {"const": "breaking"}}}}
  }
}
