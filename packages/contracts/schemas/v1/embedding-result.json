{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/contracts/schemas/v1/embedding-result.json",
  "title": "Embedding generated result v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "event_type",
    "task_id",
    "revision_id",
    "scope",
    "provenance",
    "chunks"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "event_type": { "const": "EmbeddingGenerated" },
    "task_id": { "type": "string", "format": "uuid" },
    "revision_id": { "type": "string", "format": "uuid" },
    "scope": { "type": "object", "additionalProperties": { "type": "string" } },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_revision_id", "method", "processed_at"],
      "properties": {
        "source_revision_id": { "type": "string", "format": "uuid" },
        "method": { "type": "string", "minLength": 1 },
        "processed_at": { "type": "string", "format": "date-time" }
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "ordinal",
          "start_offset",
          "end_offset",
          "text",
          "tokens",
          "checksum",
          "embedding",
          "model",
          "model_version",
          "parameters"
        ],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 0 },
          "start_offset": { "type": "integer", "minimum": 0 },
          "end_offset": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" },
          "tokens": { "type": "integer", "minimum": 1 },
          "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "embedding": { "type": "array", "minItems": 1, "items": { "type": "number" } },
          "model": { "type": "string", "minLength": 1 },
          "model_version": { "type": "string", "minLength": 1 },
          "parameters": { "type": "object", "additionalProperties": true },
          "cost": { "type": ["number", "null"], "minimum": 0 },
          "cost_currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" }
        }
      }
    }
  }
}
