{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/contracts/schemas/v1/assertion.json",
  "title": "Assertion v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "assertion_id",
    "subject",
    "predicate",
    "scope",
    "confidence",
    "method",
    "author",
    "lifecycle_state",
    "provenance",
    "command"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "assertion_id": { "type": "string", "format": "uuid" },
    "subject": { "$ref": "#/$defs/entityReference" },
    "predicate": { "$ref": "#/$defs/predicate" },
    "object": { "$ref": "#/$defs/entityReference" },
    "value": {},
    "scope": { "type": "object", "additionalProperties": true },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "method": { "type": "string", "minLength": 1 },
    "author": { "$ref": "#/$defs/actor" },
    "lifecycle_state": { "$ref": "#/$defs/lifecycleState" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "evidence_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
    "command": { "$ref": "#/$defs/command" }
  },
  "oneOf": [{ "required": ["object"] }, { "required": ["value"] }],
  "$defs": {
    "entityReference": {
      "type": "object",
      "additionalProperties": true,
      "required": ["entity_id"],
      "properties": {
        "entity_id": { "type": "string", "format": "uuid" },
        "revision_id": { "type": "string", "format": "uuid" }
      }
    },
    "predicate": {
      "enum": [
        "contains",
        "belongs_to",
        "implements",
        "calls",
        "exposes",
        "consumes",
        "produces",
        "reads",
        "writes",
        "governs",
        "documents",
        "depends_on",
        "supersedes",
        "owned_by",
        "related_to",
        "contradicts"
      ]
    },
    "lifecycleState": {
      "enum": ["observed", "draft", "candidate", "review", "published", "superseded", "retracted"]
    },
    "actor": {
      "type": "object",
      "additionalProperties": true,
      "required": ["actor_id", "actor_type"],
      "properties": {
        "actor_id": { "type": "string", "minLength": 1 },
        "actor_type": { "enum": ["human", "service", "plugin", "worker"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_revision", "method", "processed_at"],
      "properties": {
        "source_revision": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "processed_at": { "type": "string", "format": "date-time" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": true,
      "required": ["idempotency_key", "actor"],
      "properties": {
        "idempotency_key": { "type": "string", "minLength": 1 },
        "actor": { "$ref": "#/$defs/actor" }
      }
    }
  }
}
