{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/contracts/schemas/v1/documentation-code-divergence-result.json",
  "title": "Documentation/code divergence result v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "event_type", "task_id", "scope", "document_revision_id", "code_revision_id", "provenance", "execution", "divergences"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_type": {"const": "DocumentationCodeDivergenceDetected"},
    "task_id": {"type": "string", "format": "uuid"},
    "scope": {"type": "object", "additionalProperties": {"type": "string"}},
    "document_revision_id": {"type": "string", "format": "uuid"},
    "code_revision_id": {"type": "string", "format": "uuid"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "execution": {"type": "object", "required": ["detector_version", "kind", "reprocessable"], "properties": {"kind": {"const": "deterministic_comparison"}}},
    "divergences": {"type": "array", "items": {"$ref": "#/$defs/divergence"}}
  },
  "$defs": {
    "provenance": {"type": "object", "required": ["source_revision", "method", "processed_at"], "properties": {"source_revision": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}, "processed_at": {"type": "string", "format": "date-time"}}},
    "evidence": {"type": "object", "required": ["pointer"], "properties": {"pointer": {"type": "string", "minLength": 1}}},
    "divergence": {
      "type": "object",
      "required": ["candidate_key", "confidence", "assertion", "proposal"],
      "properties": {
        "candidate_key": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "assertion": {"type": "object", "required": ["subject_revision_id", "predicate", "object_revision_id", "lifecycle_state", "method", "confidence", "evidence"], "properties": {"subject_revision_id": {"type": "string", "format": "uuid"}, "predicate": {"const": "contradicts"}, "object_revision_id": {"type": "string", "format": "uuid"}, "lifecycle_state": {"const": "candidate"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/evidence"}}}},
        "proposal": {"type": "object", "required": ["kind", "subject_kind", "assertion_candidate_key", "current_text", "proposed_text", "analysis", "impacted_entities", "origin"], "properties": {"kind": {"const": "documentation_code_divergence"}, "subject_kind": {"const": "assertion"}, "assertion_candidate_key": {"type": "string", "minLength": 1}, "current_text": {"type": "string"}, "proposed_text": {"type": "string"}, "analysis": {"type": "string", "minLength": 1}, "impacted_entities": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["entity_id", "revision_id", "role"], "properties": {"entity_id": {"type": "string", "format": "uuid"}, "revision_id": {"type": "string", "format": "uuid"}, "role": {"type": "string", "minLength": 1}}}}, "origin": {"$ref": "#/$defs/provenance"}}}
      }
    }
  }
}
