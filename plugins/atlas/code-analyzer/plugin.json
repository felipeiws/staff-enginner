{
  "schema_version": "1.0.0",
  "id": "atlas.code-analyzer",
  "version": "1.0.0",
  "platform_compatibility": "^1.0.0",
  "runtime": "python_worker",
  "capabilities": ["code.analyzer"],
  "configurations": {},
  "permissions": ["artifact.read"],
  "input_schema": {"type": "object"},
  "output_schema": {"type": "object"},
  "limits": {"max_concurrency": 1, "timeout_seconds": 120, "max_payload_bytes": 20971520, "cpu_millicores": 1000, "memory_mebibytes": 1024},
  "retry_policy": {"max_attempts": 5, "backoff_seconds": 5}
}
