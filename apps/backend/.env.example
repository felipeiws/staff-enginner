APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=json_stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=atlas
DB_USERNAME=atlas
DB_PASSWORD=atlas_local_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
IDENTITY_MACHINE_TOKEN_TTL_MINUTES=15

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=atlasminio
AWS_SECRET_ACCESS_KEY=atlasminio_local_password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=atlas
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=atlas-local-typesense-key-change-me
TYPESENSE_KNOWLEDGE_ALIAS=knowledge_published
SEARCH_EMBEDDING_DIMENSIONS=1536
COPILOT_MODEL_PROVIDER=anthropic
COPILOT_MODEL=claude-opus-4-1-20250805
COPILOT_MODEL_VERSION=2025-08-05
COPILOT_MODEL_TEMPERATURE=0
COPILOT_MAX_INPUT_TOKENS=16000
COPILOT_MAX_OUTPUT_TOKENS=2048
COPILOT_MAX_REQUEST_TOKENS=18048
COPILOT_PERIOD_TOKEN_LIMIT=200000
COPILOT_PERIOD_COST_LIMIT_USD=25
COPILOT_PERIOD_HOURS=24
COPILOT_TIMEOUT_SECONDS=30
COPILOT_RETRY_ATTEMPTS=2
KNOWLEDGE_GAPS_MINIMUM_SOURCE_COUNT=1
KNOWLEDGE_GAPS_MINIMUM_EVIDENCE_SCORE=0.80
KNOWLEDGE_GAPS_WINDOW_DAYS=30
KNOWLEDGE_GAPS_DANGER_OCCURRENCES=25
COPILOT_ANTHROPIC_CACHE_SYSTEM_PROMPT=true
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

VITE_APP_NAME="${APP_NAME}"
